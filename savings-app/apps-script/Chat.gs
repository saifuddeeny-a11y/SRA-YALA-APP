/**
 * ============================================================
 *  แชตบอตการเงิน (คลินิกแก้หนี้) — ตอบอัตโนมัติ
 * ------------------------------------------------------------
 *  1) ถ้าตั้งคีย์ OpenAI ไว้ (ตั้งค่า › แชตบอต) และเปิดใช้ AI → ตอบด้วย AI
 *     คีย์เก็บใน Script Properties ชื่อ OPENAI_API_KEY (ไม่อยู่ในโค้ด/ชีต และหน้าเว็บมองไม่เห็น)
 *  2) ถ้าไม่มีคีย์ / ใช้เกินโควตาต่อวัน / AI ขัดข้อง → ตอบจากคลังคำถามที่พบบ่อย (แท็บ FAQ)
 *     ซึ่งผู้ดูแลเพิ่ม/แก้ไขได้ที่หน้า ตั้งค่า › คลังคำตอบแชตบอต
 * ============================================================
 */

var OPENAI_URL = 'https://api.openai.com/v1/chat/completions';

/**
 * ถามแชตบอต
 * history = [{ role: 'user'|'assistant', content: '...' }, ...] (ข้อความล่าสุดต้องเป็นของผู้ใช้)
 * คืน { answer, source: 'ai'|'faq'|'help', remaining }
 */
function chatAsk(token, history) {
  var s = requireSession_(token);
  history = (Array.isArray(history) ? history : []).slice(-12).map(function (h) {
    return { role: h && h.role === 'assistant' ? 'assistant' : 'user', content: text_(h && h.content, 1500) };
  }).filter(function (h) { return h.content; });
  var last = history[history.length - 1];
  if (!last || last.role !== 'user') throw new Error('กรุณาพิมพ์คำถาม');
  var q = last.content;

  var settings = getSettings_();
  var limit = Number(settings.chatDailyLimit || 30) || 30;
  var who = s.kind === 'member' ? 'member:' + s.memberNo : s.username;
  var today = todayIso_();
  var used = readTable_('ChatLog').filter(function (r) { return r.who === who && r.source === 'ai' && String(r.time).substr(0, 10) === today; }).length;
  var key = PropertiesService.getScriptProperties().getProperty('OPENAI_API_KEY');
  var aiOn = !!key && settings.aiEnabled !== 'FALSE' && used < limit;

  var answer = '', source = '';
  if (aiOn) {
    try {
      answer = askOpenAI_(key, settings, s, history);
      source = 'ai';
    } catch (err) {
      Logger.log('OpenAI error: ' + err);
      answer = '';
    }
  }
  if (!answer) {
    var hit = faqAnswer_(q);
    if (hit) { answer = hit.answer; source = 'faq'; }
    else { answer = helpAnswer_(settings, key && used >= limit); source = 'help'; }
  }
  logChat_(who, s.role, q, source);
  return { answer: answer, source: source, remaining: key && settings.aiEnabled !== 'FALSE' ? Math.max(0, limit - used - (source === 'ai' ? 1 : 0)) : null };
}

function logChat_(who, role, q, source) {
  try {
    withLock_(function () {
      insertRow_('ChatLog', { id: newId_(), time: nowIso_(), who: who, role: role, question: text_(q, 300), source: source });
      var sh = sheet_('ChatLog');
      if (sh.getLastRow() > 3000) { sh.deleteRows(2, 1000); delete _tableCache.ChatLog; }
    });
  } catch (err) { }
}

/* ------------------------------------------------------------
 *  AI (OpenAI Chat Completions)
 * ------------------------------------------------------------ */
