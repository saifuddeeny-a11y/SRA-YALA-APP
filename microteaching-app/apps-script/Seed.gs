function seedPages_() {
  var have = {};
  readTable_('Pages').forEach(function (p) { have[p.key] = 1; });
  var now = nowIso_();
  PAGE_SEED.forEach(function (p, i) {
    if (have[p[0]]) return;
    insertRow_('Pages', { key: p[0], title: p[1], icon: p[2], inMenu: p[3], body: p[4].join('\n'), order: String((i + 1) * 10), updatedAt: now });
  });
}

